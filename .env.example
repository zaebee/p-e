# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Both values come from an OpenAI Platform organization at
# platform.openai.com — not from a ChatGPT subscription.

# platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_...

# platform.openai.com/settings/organization/api-keys
# Needs Tunnels Read + Use. Do NOT put an admin key here: the quickstart
# is explicit that the long-lived daemon must not be given one.
CONTROL_PLANE_API_KEY=sk-...
