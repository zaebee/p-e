dist/
.DS_Store

# Credentials. This repository is public and every commit here has been
# made with `git add -A`; an unignored .env would have gone out with the
# next one.
.env
.env.*
!.env.example

# Editor scratch. A swap file appeared in relay/ and was staged by
# git add -A; the store must hold records and nothing else.
*.swp
*.swo
*~

# The bench writes a patched copy of the publisher next to the original, because
# relative imports resolve from there and nowhere else. It is removed on exit,
# including on failure; this is in case a run is killed between the two.
src/relay-lite/.publish-nodirsync.ts
