{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": { "enabled": true, "lineWidth": 100, "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "files": {
    "ignore": [
      // Frozen evidence, not source. A formatter run over either of these would
      // rewrite bytes that are pinned by digest — `corpus/manifest.json` for the
      // first, `docs/experiments/debian-rb-retrieval.md` for the second — and the
      // rewrite would be silent, leaving every recorded digest wrong and the
      // "verbatim" claim false. `biome check --write .` was one keystroke from
      // doing exactly that to the Debian bytes on 2026-08-28.
      "corpus/**",
      "docs/experiments/debian-rb-bytes/**",
      "node_modules/**"
    ]
  }
}
