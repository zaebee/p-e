{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": { "enabled": true, "lineWidth": 100, "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "files": {
    "ignore": [
      // Frozen evidence, not source. A formatter run over either of these would
      // rewrite bytes that are pinned by digest — `corpus/manifest.json` for the
      // first, `docs/experiments/debian-rb-retrieval.md` for the second — and the
      // rewrite would be silent, leaving every recorded digest wrong and the
      // "verbatim" claim false. `biome check --write .` was one keystroke from
      // doing exactly that to the Debian bytes on 2026-08-28.
      "corpus/**",
      "docs/experiments/debian-rb-bytes/**",

      // Same class, added later and not covered until now: material handed to a
      // blind reader. `clause-reader/CONTRACT.md` is "Set by bee.zae. Reproduced
      // verbatim"; `suite-audit/PROMPT.md` calls its tree "the code you are
      // auditing". Formatting either would change what a reader was shown, and
      // no later run could tell which differences were the reader's and which
      // were the formatter's.
      //
      // The rule is the class, not the file. A repository that stores captured
      // artefacts beside its own source has two kinds of file with opposite
      // rules, and formatting conventions apply to one of them.
      "docs/experiments/clause-reader/corpus/**",
      "docs/experiments/suite-audit/suite/**",

      "node_modules/**"
    ]
  }
}
